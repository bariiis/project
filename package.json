{
  "name": "promptsite",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "library:check": "pnpm --filter @promptsite/compiler library:check",
    "db:generate": "pnpm --filter @promptsite/db generate",
    "db:migrate": "pnpm --filter @promptsite/db migrate",
    "admin:grant": "pnpm --filter @promptsite/db admin:grant"
  }
}
