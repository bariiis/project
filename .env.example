# App: public address of the site, read at runtime (auth callbacks, checkout return URL)
SITE_URL=http://localhost:3000
# Outside production only: pretend the visitor is on this plan (free | pro | power).
DEV_PLAN=free

# Database (phase 1)
DATABASE_URL=postgres://promptsite:promptsite@localhost:5432/promptsite

# Media storage: MinIO or any S3-compatible bucket (phase 1)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=promptsite-assets
S3_ACCESS_KEY=promptsite
S3_SECRET_KEY=promptsite-secret
S3_PUBLIC_URL=http://localhost:9000/promptsite-assets

# Auth (phase 1, Better Auth)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (phase 1, Lemon Squeezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_POWER=
# Display prices on the pricing section, e.g. "$149 / yıl"
PRICE_PRO_LABEL=
PRICE_POWER_LABEL=
# Max compositions per signed-in user per 24h
DAILY_COMPOSITION_LIMIT=300
# Leave empty for MinIO; set for AWS or other S3 providers
S3_REGION=
