# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Outside production only: pretend the visitor is on this plan (free | pro | power).
DEV_PLAN=free

# Database (phase 1)
DATABASE_URL=postgres://promptsite:promptsite@localhost:5432/promptsite

# Media storage: MinIO or any S3-compatible bucket (phase 1)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=promptsite-assets
S3_ACCESS_KEY=promptsite
S3_SECRET_KEY=promptsite-secret
S3_PUBLIC_URL=http://localhost:9000/promptsite-assets

# Auth (phase 1, Better Auth)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (phase 1, Lemon Squeezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_POWER=
